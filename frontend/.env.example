NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- /phase1 private dashboard (names only; real values go in Vercel / .env.local, never here) ---
# Supabase project "arepolabs-phase1" (separate from the Arepo research database).
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Bypasses RLS; used by route handlers after the allowlist check.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL for the invite links printed by scripts/phase1/invite.ts: <site url>/phase1/enrol?token=...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated sign-in allowlist. Example value:
PHASE1_ALLOWED_EMAILS=dayyan.sheikh@arepolabs.com,jack.burbridge@arepolabs.com
# Passkey sign-in (replaces the emailed magic link). See scripts/phase1/README.md
# Random, at least 32 characters (e.g. `openssl rand -base64 48`); signs the session cookie. Server only.
PHASE1_SESSION_SECRET=
# WebAuthn relying party: the registrable domain, e.g. arepolabs.com (a preview: its exact host)
PHASE1_RP_ID=
# Comma-separated exact origins allowed to sign in, e.g. https://www.arepolabs.com,https://arepolabs.com
PHASE1_ORIGINS=
# Gmail send and sync (scopes gmail.send + gmail.readonly). Redirect URI: <site>/phase1/api/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32-byte key (base64 or hex) that encrypts Gmail refresh tokens at rest (WP5)
PHASE1_TOKEN_KEY=
# Optional: the shared enquiries address (any allowed user can send from it)
PHASE1_SHARED_ADDRESS=enquiries@arepolabs.com
# Tests only: in-memory store and cookie sessions. Refused on production Vercel. Leave unset.
PHASE1_TEST_MODE=
PHASE1_TEST_USER=
