NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- /phase1 private dashboard (names only; real values go in Vercel / .env.local, never here) ---
# Supabase project "arepolabs-phase1" (separate from the Arepo research database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; used by route handlers after the allowlist check.
SUPABASE_SERVICE_ROLE_KEY=
# Used for the magic-link redirect: <site url>/phase1/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated sign-in allowlist. Example value:
PHASE1_ALLOWED_EMAILS=dayyan.sheikh@arepolabs.com,jack.burbridge@arepolabs.com
# Gmail read-only sync (WP5)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32-byte key (base64 or hex) that encrypts Gmail refresh tokens at rest (WP5)
PHASE1_TOKEN_KEY=
# Tests only: in-memory store and cookie sessions. Refused on production Vercel. Leave unset.
PHASE1_TEST_MODE=
PHASE1_TEST_USER=
